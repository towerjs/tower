{
  "name": "@towerjs/blueprint",
  "version": "0.1.0",
  "description": "Application definition, module registration, and per-request context for Tower",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@towerjs/foundation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyphenzero/tower.git",
    "directory": "packages/blueprint"
  },
  "homepage": "https://github.com/hyphenzero/tower#readme",
  "engines": {
    "node": ">=22.6"
  }
}
