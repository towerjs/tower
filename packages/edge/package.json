{
  "name": "@towerjs/edge",
  "version": "0.1.0",
  "description": "Edge runtime integration for Tower — resolves tower.config.ts in constrained environments like Vercel Edge Runtime",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "dependencies": {
    "@towerjs/tower": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "next": "^16.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/towerjs/tower.git",
    "directory": "packages/edge"
  },
  "homepage": "https://github.com/towerjs/tower#readme",
  "engines": {
    "node": ">=22.6"
  }
}