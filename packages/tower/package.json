{
  "name": "@towerjs/tower",
  "version": "0.1.0",
  "description": "Tower application core — Foundation, Blueprint, and runtime primitives",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./blueprint": {
      "types": "./dist/blueprint/index.d.ts",
      "default": "./dist/blueprint/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation/index.d.ts",
      "default": "./dist/foundation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist ../../.cache/tower/tower.tsbuildinfo && tsc -b"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "next": "^16.3.0"
  },
  "dependencies": {},
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/towerjs/tower.git",
    "directory": "packages/tower"
  },
  "homepage": "https://github.com/towerjs/tower#readme",
  "engines": {
    "node": ">=22.6"
  }
}