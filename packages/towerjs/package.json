{
  "name": "towerjs",
  "version": "0.1.0",
  "description": "Meta-package that bundles all Tower modules for convenient access",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blueprint": {
      "types": "./dist/blueprint.d.ts",
      "default": "./dist/blueprint.js"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./gatehouse": {
      "types": "./dist/gatehouse.d.ts",
      "default": "./dist/gatehouse.js"
    },
    "./gatehouse/actions": {
      "types": "./dist/gatehouse/actions.d.ts",
      "default": "./dist/gatehouse/actions.js"
    },
    "./gatehouse/next": {
      "types": "./dist/gatehouse/next.d.ts",
      "default": "./dist/gatehouse/next.js"
    },
    "./gatehouse/client": {
      "types": "./dist/gatehouse/client.d.ts",
      "default": "./dist/gatehouse/client.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./courier": {
      "types": "./dist/courier.d.ts",
      "default": "./dist/courier.js"
    }
  },
  "bin": {
    "tower": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "next": "^16"
  },
  "dependencies": {
    "@towerjs/foundation": "workspace:*",
    "@towerjs/vault": "workspace:*",
    "@towerjs/gatehouse": "workspace:*",
    "@towerjs/courier": "workspace:*",
    "@towerjs/blueprint": "workspace:*",
    "jiti": "^2.4.2"
  }
}
