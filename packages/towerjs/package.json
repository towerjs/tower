{
  "name": "towerjs",
  "version": "0.1.0",
  "description": "Meta-package that bundles all Tower modules for convenient access",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./vault": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    },
    "./gatehouse": {
      "types": "./dist/gatehouse.d.ts",
      "default": "./dist/gatehouse.js"
    },
    "./courier": {
      "types": "./dist/courier.d.ts",
      "default": "./dist/courier.js"
    }
  },
  "bin": { "tower": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": { "build": "tsc -b" },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "dependencies": {
    "@towerjs/foundation": "workspace:*",
    "@towerjs/vault": "workspace:*",
    "@towerjs/gatehouse": "workspace:*",
    "@towerjs/courier": "workspace:*",
    "@towerjs/blueprint": "workspace:*",
    "better-auth": "^1.6.25",
    "jiti": "^2.4.2"
  }
}
