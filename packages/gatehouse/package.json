{
  "name": "@towerjs/gatehouse",
  "version": "0.1.0",
  "description": "Authentication and authorization for Tower — email/password, social, 2FA, organizations, and more",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/frameworks/next.d.ts",
      "default": "./dist/frameworks/next.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@towerjs/blueprint": "workspace:*",
    "@towerjs/foundation": "workspace:*",
    "better-auth": "^1.6.25",
    "kysely": "^0.29.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "next": "16"
  }
}
