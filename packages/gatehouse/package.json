{
  "name": "@towerjs/gatehouse",
  "version": "0.1.0",
  "description": "Authentication and authorization for Tower — email/password, social, 2FA, organizations, and more",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/frameworks/next.d.ts",
      "default": "./dist/frameworks/next.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./actions": {
      "types": "./dist/frameworks/actions/index.d.ts",
      "default": "./dist/frameworks/actions/index.js"
    },
    "./react-server": {
      "types": "./dist/frameworks/react-server.d.ts",
      "default": "./dist/frameworks/react-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.26",
    "@better-auth/passkey": "^1.6.26",
    "@towerjs/tower": "workspace:*",
    "better-auth": "^1.6.26",
    "kysely": "^0.29.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "next": "^16.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/towerjs/tower.git",
    "directory": "packages/gatehouse"
  },
  "homepage": "https://github.com/towerjs/tower#readme",
  "engines": {
    "node": ">=22.6"
  }
}