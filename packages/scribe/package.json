{
  "name": "@towerjs/scribe",
  "version": "0.1.0",
  "description": "CLI for scaffolding and managing Tower applications",
  "type": "module",
  "bin": {
    "tower": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands/create": {
      "types": "./dist/commands/create.d.ts",
      "default": "./dist/commands/create.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@inquirer/type": "^4.0.7",
    "@towerjs/courier": "workspace:*",
    "@towerjs/gatehouse": "workspace:*",
    "@towerjs/tower": "workspace:*",
    "@towerjs/vault": "workspace:*",
    "execa": "^10.0.1",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/towerjs/tower.git",
    "directory": "packages/scribe"
  },
  "homepage": "https://github.com/towerjs/tower#readme",
  "engines": {
    "node": ">=22.6"
  }
}