{
  "name": "@towerjs/scribe",
  "version": "0.1.0",
  "description": "CLI for scaffolding and managing Tower applications",
  "type": "module",
  "bin": {
    "tower": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands/create": {
      "types": "./dist/commands/create.d.ts",
      "default": "./dist/commands/create.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@inquirer/type": "^4.0.7",
    "@towerjs/courier": "workspace:*",
    "@towerjs/foundation": "workspace:*",
    "@towerjs/gatehouse": "workspace:*",
    "@towerjs/vault": "workspace:*",
    "execa": "^10.0.0",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^26"
  }
}
