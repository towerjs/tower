{
  "name": "tower",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "format": "prettier --write .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist .cache/tower",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @towerjs/with-nextjs test:e2e",
    "check:deps": "npx tsx scripts/check-dependencies.ts",
    "check:versions": "node scripts/check-release-versions.mjs",
    "check:initial-version": "node scripts/check-release-versions.mjs --initial",
    "changeset": "changeset",
    "version": "changeset version && pnpm install",
    "release": "pnpm check:versions && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "oxlint": "1.77.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "es5",
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "packageManager": "pnpm@11.17.0"
}
