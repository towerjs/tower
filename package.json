{
  "name": "tower",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "format": "prettier --write .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist .cache/tower",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "bash scripts/test-integration.sh",
    "test:build": "vitest run --project build",
    "test:e2e": "bash scripts/test-e2e.sh",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down -v",
    "check:deps": "npx tsx scripts/check-dependencies.ts",
    "check:versions": "node scripts/check-release-versions.mjs",
    "check:initial-version": "node scripts/check-release-versions.mjs --initial",
    "version:patch": "node scripts/version-packages.mjs patch",
    "version:minor": "node scripts/version-packages.mjs minor",
    "version:major": "node scripts/version-packages.mjs major",
    "version:set": "node scripts/version-packages.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "expect-type": "^1.4.0",
    "oxlint": "1.77.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "es5",
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^node:",
      "^@towerjs/",
      "^@?\\w",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  },
  "packageManager": "pnpm@11.17.0"
}
