{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "towerjs": [
        "../../packages/towerjs/src/index.ts"
      ],
      "@towerjs/foundation": [
        "../../packages/foundation/src/index.ts"
      ],
      "@towerjs/blueprint": [
        "../../packages/blueprint/src/index.ts"
      ],
      "@towerjs/vault": [
        "../../packages/vault/src/index.ts"
      ],
      "@towerjs/gatehouse": [
        "../../packages/gatehouse/src/index.ts"
      ],
      "@towerjs/gatehouse/next-js": [
        "../../packages/gatehouse/src/frameworks/next-js.ts"
      ],
      "@towerjs/gatehouse/next": [
        "../../packages/gatehouse/src/frameworks/next-js.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
