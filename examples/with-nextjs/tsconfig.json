{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "towerjs": ["../../packages/towerjs/dist/index"],
      "@towerjs/foundation": ["../../packages/foundation/dist/index"],
      "@towerjs/blueprint": ["../../packages/blueprint/dist/index"],
      "@towerjs/vault": ["../../packages/vault/dist/index"],
      "@towerjs/gatehouse": ["../../packages/gatehouse/dist/index"],
      "@towerjs/gatehouse/next-js": ["../../packages/gatehouse/dist/frameworks/next-js"],
      "@towerjs/gatehouse/next": ["../../packages/gatehouse/dist/frameworks/next-js"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
